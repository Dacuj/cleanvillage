# Copy this file to .env.local and fill in your Supabase project values.
# Find them at: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side only (set these in Vercel → Settings → Environment Variables) ---

# Transactional emails (quote notifications + customer receipts) via resend.com.
# Without this key the site still works: requests are saved in the database,
# but no email is sent.
RESEND_API_KEY=

# AI machine-finder (/scopri-macchina) via Google Gemini.
GEMINI_API_KEY=
